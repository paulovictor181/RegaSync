server {
  listen 80;
  server_name ${PUBLIC_IP};
  location ^~ /.well-known/acme-challenge/ { root /var/www/certbot; }
  location / { return 301 https://$host$request_uri; }
}
server {
  listen 443 ssl;
  server_name ${PUBLIC_IP};
  ssl_certificate /etc/letsencrypt/live/${PUBLIC_IP}/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/${PUBLIC_IP}/privkey.pem;
  location / { proxy_pass http://app:8080; proxy_set_header Host ${PUBLIC_IP}; proxy_set_header X-Forwarded-Host ${PUBLIC_IP}; proxy_set_header X-Forwarded-Proto https; proxy_set_header X-Forwarded-For $remote_addr; }
}
